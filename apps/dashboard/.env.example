# Recalbox connection
RECALBOX_HOST=recalbox.local
RECALBOX_SSH_USER=root
RECALBOX_SSH_PASSWORD=recalboxroot

# MQTT broker (running on Recalbox)
MQTT_BROKER_URL=mqtt://recalbox.local:1883
MQTT_TOPIC_PREFIX=recalbox

# SMB / network share for gamelists
GAMELIST_BASE_PATH=/mnt/recalbox/share/roms

# Database
DATABASE_PATH=./recalbox.db

# App
NEXT_PUBLIC_APP_NAME=Recalbox Dashboard

# Auth (Better Auth) — generate a 32+ char secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins Better Auth accepts (CSRF / cross-origin). For a public
# Tailscale Funnel deployment, set this to the public URL, e.g.
# https://<node>.<tailnet>.ts.net (add any MagicDNS name too). Defaults to
# BETTER_AUTH_URL when unset.
BETTER_AUTH_TRUSTED_ORIGINS=

# Credential encryption (SSH/IGDB secrets at rest).
# Optional: defaults to deriving a key from BETTER_AUTH_SECRET.
# Set only to rotate the credential key independently of the auth secret.
CREDENTIALS_SECRET=

# ── Serverless edition (Turso + Vercel Blob + on-box agent) ──────────────────
# See docs/serverless-deploy.md. When TURSO_DATABASE_URL is set the app uses the
# remote libSQL DB instead of the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 for a direct-remote libSQL client (no local embedded replica).
# REQUIRED at build time (parallel build workers lock the replica file) and the
# right runtime mode on Vercel's ephemeral functions.
TURSO_DISABLE_REPLICA=
# Vercel Blob token. When set, agent artwork is stored in Blob; otherwise a
# local-filesystem adapter is used (dev), served by /api/blob.
BLOB_READ_WRITE_TOKEN=
# Set to 1 so /api/media serves only object-storage artwork (no SSH to the box);
# a miss is marked "wanted" for the agent to upload on its next poll.
AGENT_ONLY_MEDIA=
